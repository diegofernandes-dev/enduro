; Engine configuration file.
; Godot 4.7.2 — Enduro Marco A

config_version=5

[application]

config/name="Enduro"
config/description="Faithful recreation of Enduro (Activision, 1983) for Atari 2600 — Marco A"
config/version="0.1.0-marco-a"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

GameParams="*res://scripts/autoload/game_params.gd"
GameInput="*res://scripts/autoload/game_input.gd"

[display]

window/size/viewport_width=160
window/size/viewport_height=192
; Display as 4:3 landscape like a CRT TV. Internal 160x192 is stretched
; horizontally (non-square pixels), matching how the Atari 2600 looked on TV —
; not a tall/square portrait window.
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="ignore"
window/stretch/scale_mode="fractional"

